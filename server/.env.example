# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/easyride
# Local MongoDB:  mongodb://localhost:27017/easyride
MONGODB_URI=mongodb://localhost:27017/easyride

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret — e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your production frontend domain (no trailing slash)
# e.g. https://app.easyride.co.zw
ALLOWED_ORIGIN=https://your-domain.com

# ── Client URL ────────────────────────────────────────────────────────────────
# Used in SOS tracking links sent via SMS; usually same host as ALLOWED_ORIGIN
CLIENT_URL=https://your-domain.com

# ── Paynow Zimbabwe ───────────────────────────────────────────────────────────
# Get from: https://www.paynow.co.zw → Business → Integrations
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Your public server URL — used for Paynow payment callbacks
BASE_URL=https://your-domain.com

# ── Africa's Talking (SMS OTP + WhatsApp) ────────────────────────────────────
# Get from: https://account.africastalking.com
# Use "sandbox" as username for testing
AT_USERNAME=sandbox
AT_API_KEY=
# WhatsApp Business number — dedicated SIM registered via AT dashboard
AT_WA_NUMBER=+263XXXXXXXXX
AT_WA_PRODUCT=EasyRide

# ── Firebase Admin (Push Notifications) ──────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON object on ONE line (minified)
FIREBASE_SERVICE_ACCOUNT=

# ── TURN Server (WebRTC calls) ────────────────────────────────────────────────
# Replace with your own TURN server for production (metered.ca has a free tier)
TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turns:openrelay.metered.ca:443
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# ── Sentry (Error Tracking) ──────────────────────────────────────────────────
# Create a project at sentry.io → Settings → Projects → Client Keys (DSN)
# Leave blank to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Google Maps Geocoding (optional, falls back to Nominatim) ────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Enable billing and set a budget alert — queries cost ~$5/1000 after free tier
GOOGLE_MAPS_API_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
# pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# ── Demo seed data (dev only) ────────────────────────────────────────────────
# Set NO_SEED=1 to disable seeding even in dev
# Change DEMO_PASSWORD to override the default demo accounts password
NO_SEED=
DEMO_PASSWORD=
