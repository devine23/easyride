dist/
build/
client/dist/
coverage/
*.tsbuildinfo

# ─── Logs ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/
pm2-*.log

# ─── OS / editor ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ─── Android (keep source, ignore builds + signing) ────────────────
client/android/app/build/
client/android/.gradle/
client/android/build/
client/android/local.properties
client/android/capacitor-cordova-android-plugins/
*.keystore
*.jks

# ─── iOS (if added later) ──────────────────────────────────────────
